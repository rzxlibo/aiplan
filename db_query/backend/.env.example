# OpenAI API Key for natural language to SQL conversion
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Custom data directory (defaults to ~/.db_query)
DB_QUERY_DATA_DIR=~/.db_query

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*

# Optional: OpenAI-compatible API endpoint (e.g. One-API gateway, DeepSeek, Ollama).
# Leave empty to use OpenAI official endpoint.
OPENAI_BASE_URL=
# Model name to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
